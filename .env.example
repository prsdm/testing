# Root reference only. Copy backend/.env.example to backend/.env and
# frontend/.env.example to frontend/.env when running the projects.

# Public browser origin. In production both values must be the same HTTPS origin.
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=
KIMIRO_WEB_ORIGIN=http://localhost:5173

# API process (KIMIRO_API_PORT defaults to 3002)
KIMIRO_API_PORT=3002
# Vite development proxy only; production browsers use same-origin /api routes.
KIMIRO_API_URL=http://127.0.0.1:3002

# Web edge/container runtime; use an internal API service URL, never a secret.
API_UPSTREAM=http://api:3002

# Optional SPA subpath deploy (e.g. /app)
# KIMIRO_BASE_PATH=

# Required by the API and the one-shot migration job.
POSTGRES_URL=postgresql://postgres:password@localhost:5433/kimi
# Optional API cache.
REDIS_URL=redis://localhost:6379

# Stripe (billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SEAT_MONTHLY=
STRIPE_PRICE_SEAT_YEARLY=

# Sandbox (optional)
SANDBOX_ENABLED=false
SANDBOX_EXECUTOR_URL=http://127.0.0.1:8089
SANDBOX_SKIP_GCS_SYNC=true
