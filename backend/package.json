{
  "name": "kimiro-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm migration:check && pnpm build",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:pull": "drizzle-kit pull --config=drizzle.config.ts",
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "db:up": "drizzle-kit up --config=drizzle.config.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "index:drive": "tsx scripts/index-tenant-drive.ts",
    "index:slack": "tsx scripts/index-tenant-slack.ts",
    "knowledge-bases:reindex": "tsx scripts/reindex-knowledge-base-chunks.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "local:fresh-setup": "tsx scripts/local-fresh-setup.ts",
    "local:reset": "tsx scripts/local-reset.ts",
    "local:reset:pg": "tsx scripts/local-reset-pg.ts",
    "migrate": "tsx src/migration/migrate.ts",
    "migrate:start": "NODE_ENV=production node dist/migrate.js --no-env",
    "migration:check": "tsx src/migration/migrate.ts --check",
    "people:sync": "tsx scripts/people-sync-runner.ts",
    "sandbox:build": "docker compose -f docker-compose.sandbox.yml build",
    "sandbox:down": "docker compose -f docker-compose.sandbox.yml down",
    "sandbox:test": "bash scripts/sandbox-exec-test.sh",
    "sandbox:up": "docker compose -f docker-compose.sandbox.yml up -d",
    "sources:acl:backfill": "tsx scripts/backfill-sources-acl.ts",
    "sources:acl:refresh": "tsx scripts/refresh-sources-acl.ts",
    "sources:acl:repair": "tsx scripts/repair-sources-acl.ts",
    "sources:reindex": "tsx scripts/reindex-sources-search.ts",
    "sso:onboard": "tsx scripts/sso-onboard.ts",
    "start": "NODE_ENV=production node dist/server.js",
    "start:dev": "tsx --env-file-if-exists=.env src/server.ts",
    "test": "TSX_TSCONFIG_PATH=tsconfig.json node --import tsx --test \"src/{core,shared}/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "vespa:deploy": "tsx scripts/vespa-deploy.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.38",
    "@ai-sdk/google": "^4.0.43",
    "@ai-sdk/openai": "^4.0.41",
    "@better-auth/sso": "^1.6.9",
    "@google-cloud/storage": "^7.21.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.0",
    "@tavily/core": "^0.7.6",
    "ai": "^7.0.64",
    "bcrypt-ts": "^5.0.2",
    "better-auth": "^1.6.9",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "docx": "^9.7.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.34.0",
    "exa-js": "^2.16.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "google-auth-library": "^10.6.2",
    "hyperformula": "^3.3.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "papaparse": "^5.5.2",
    "pdf-parse": "^1.1.1",
    "postgres": "^3.4.4",
    "redis": "^5.0.0",
    "stripe": "22.4.0",
    "tailwind-merge": "^2.5.2",
    "ws": "^8.21.3",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.7",
    "@biomejs/biome": "2.5.14",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "22.8.6",
    "@types/papaparse": "5.3.15",
    "@types/pdf-parse": "1.1.4",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.25.0",
    "esbuild": "0.19.12",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "ultracite": "^7.0.11"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  }
}
