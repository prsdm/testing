{
  "env": {
    "VITE_PREVIEW_MODE": "1"
  },
  "installCommand": "npx -y pnpm@10.32.1 install --frozen-lockfile",
  "buildCommand": "VITE_PREVIEW_MODE=1 npx -y pnpm@10.32.1 run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
