{
  "env": {
    "VITE_PREVIEW_MODE": "1"
  },
  "installCommand": "npm install -g pnpm@10.32.1 && pnpm install --frozen-lockfile",
  "buildCommand": "VITE_PREVIEW_MODE=1 pnpm build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
